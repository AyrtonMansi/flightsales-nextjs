# ============================================
# Public Supabase credentials — required for all reads/writes.
# Available in Supabase project settings → API.
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...

# Server-only Supabase service role. Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...

# ============================================
# Pre-launch site gate.
# Keep both protection flags aligned. SITE_PASSWORD is server-only.
# Set both flags to false when the marketplace is ready to be public.
# ============================================
SITE_PASSWORD_PROTECTED=true
NEXT_PUBLIC_SITE_PASSWORD_PROTECTED=true
SITE_PASSWORD=replace-with-a-long-random-password

# ============================================
# Resend — transactional email provider.
# ============================================
RESEND_API_KEY=re_...
EMAIL_FROM="FlightSales <noreply@flightsales.com.au>"
EMAIL_REPLY_TO=support@flightsales.com.au
EMAIL_BCC_ADMIN=ops@flightsales.com.au

# INTERNAL_API_TOKEN is no longer used and must NOT be reintroduced.
# It was a shared secret that bypassed the admin auth gate entirely. If you
# need a server-to-server caller in future, give it a narrowly scoped
# credential rather than a global admin skeleton key.
# Delete this variable from any deploy environment that still has it set.

# Canonical production origin used by links / metadata where required.
NEXT_PUBLIC_SITE_URL=https://flightsales.com.au

# ============================================
# ABN — appears in the footer for AU compliance.
# ============================================
NEXT_PUBLIC_FS_ABN=12345678901

# ============================================
# Cloudflare Turnstile — required before opening the public marketplace.
# ============================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ============================================
# Upstash Redis — required production rate-limit backend for public writes.
# RATELIMIT_PEPPER pseudonymises identifiers before they reach Redis.
# Generate a random 32+ byte value and keep it server-only.
# ============================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATELIMIT_PEPPER=

# ============================================
# Vercel Cron — auth header expected by scheduled routes.
# ============================================
CRON_SECRET=
